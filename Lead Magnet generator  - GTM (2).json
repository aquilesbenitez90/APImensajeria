      "parameters": {
        "jsCode": "const result = $('Consultar resultado1').item.json;\nif (result.status !== 'ok') {\n  throw new Error('El job no terminó OK: ' + JSON.stringify(result));\n}\nconst base64 = result.pdf_base64;\nif (!base64) {\n  throw new Error('No se recibió pdf_base64 del servidor');\n}\n\n// Nombre profesional: usa el que manda el server (pdf_filename); si no viene,\n// lo arma con la empresa. Saca caracteres ilegales para nombres de archivo.\nconst empresaLimpia = String(result.empresa || 'Empresa').replace(/[\\\\/:*?\"<>|]/g, '').trim();\nconst fileName = result.pdf_filename || ('Análisis de Mercado - ' + empresaLimpia + '.pdf');\n\nreturn [{\n  json: {\n    email: result.email,\n    empresa: result.empresa,\n    nombre: result.nombre,\n    pdf_filename: fileName,\n    paginas: result.paginas,\n    juez: result.juez,\n    tokens_input: result.tokens_input,\n    tokens_output: result.tokens_output,\n    tokens_cache_write: result.tokens_cache_write,\n    tokens_cache_read: result.tokens_cache_read\n  },\n  binary: {\n    reporte: {\n      data: base64,\n      mimeType: 'application/pdf',\n      fileName: fileName\n    }\n  }\n}];"
      },
